# Banco PostgreSQL (Neon, Supabase, Railway...). DIRECT_URL = conexão sem pooler (para migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/golden"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/golden"

# Segredo para assinar a sessão de login (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo"

# Usuário administrador criado pelo seed
ADMIN_EMAIL="golden@goldenartefatosdemadeira.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# URL pública da plataforma (usada nos links do catálogo enviados aos clientes)
APP_URL="http://localhost:3000"

# Número de WhatsApp da Golden que recebe os pedidos do catálogo (só dígitos, com 55)
COMPANY_WHATSAPP="5554996105511"

# ---- WhatsApp Cloud API (Meta) ----
# Sem WHATSAPP_TOKEN a plataforma roda em MODO SIMULAÇÃO (nada é enviado de verdade)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="golden-webhook-verify"
WHATSAPP_API_VERSION="v23.0"
